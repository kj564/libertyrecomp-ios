# LibertyRecomp Remote — Environment Variables
# Copy this file to .env and fill in your paths

# Path to LibertyRecomp.exe
# Download from https://github.com/OZORDI/LibertyRecomp/releases
# Windows: C:\Users\You\AppData\Local\LibertyRecomp\LibertyRecomp.exe
# macOS:   /Applications/LibertyRecomp.app/Contents/MacOS/LibertyRecomp
# Linux:   /home/you/LibertyRecomp/LibertyRecomp
LIBERTY_EXE_PATH=/usr/bin/echo

# Working directory (where game files are)
# Leave empty to use the .exe's parent directory
LIBERTY_WORK_DIR=
