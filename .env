DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- claude-faceless-shorts-creator (from .env.example) ---
# ElevenLabs — required for voice (tools/gen_voice.py); also powers sound-effect
# generation (tools/gen_sfx.py) and music beds (tools/gen_music.py).
ELEVENLABS_API_KEY=
# Google Gemini — image generation (tools/gen_image.py), e.g. story frames.
GEMINI_API_KEY=
# fal.ai — optional, generative video clips (tools/gen_clip.py).
FAL_KEY=
